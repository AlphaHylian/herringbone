{
  "name": "herringbone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A calm, tactile brick-paving puzzle game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:3d": "vite --config vite.paver.config.ts",
    "build:3d": "tsc --noEmit && vite build --config vite.paver.config.ts",
    "preview:3d": "vite preview --config vite.paver.config.ts",
    "build:pages": "pnpm build && pnpm build:3d && rm -rf site && cp -r dist-paver site && cp -r dist site/2d && touch site/.nojekyll",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "icons": "node scripts/generate-icons.mjs && capacitor-assets generate --ios --android --iconBackgroundColor '#e8d9bf' --iconBackgroundColorDark '#2e261f' --splashBackgroundColor '#e8d9bf' --splashBackgroundColorDark '#2e261f'",
    "levels": "node scripts/build-levels.mjs && prettier --write src/levels",
    "cap:sync": "pnpm build && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "clipper2-ts": "2.0.1-18",
    "pixi.js": "^8.22.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
